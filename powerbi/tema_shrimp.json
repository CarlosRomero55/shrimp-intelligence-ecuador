{
  "name": "Shrimp Intelligence Ecuador",
  "dataColors": ["#0B4F6C", "#FF6F59", "#1F7A8C", "#E9C46A", "#7FB7BE", "#B0B7BF", "#FFB4A2", "#22313F"],
  "background": "#FFFFFF",
  "foreground": "#22313F",
  "tableAccent": "#0B4F6C",
  "good": "#1F7A8C",
  "neutral": "#E9C46A",
  "bad": "#FF6F59",
  "maximum": "#0B4F6C",
  "center": "#7FB7BE",
  "minimum": "#E4E7EB",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#0B4F6C" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#22313F" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#22313F" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#52606D" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F8" } }, "transparency": 0 }]
